# Local PostgreSQL (docker compose up -d db).
# Copy to .env. Never commit real connection credentials.
DATABASE_URL=postgresql://flashcards:flashcards_local@127.0.0.1:5432/flashcards
HOST=127.0.0.1
PORT=3000

# Public deployment: NODE_ENV=production and exact HTTPS origin, without trailing /.
# NODE_ENV=production
# APP_ORIGIN=https://your-app.onrender.com
# TRUST_PROXY=1  # Only behind one trusted reverse proxy (Render).
AUTH_ALLOW_REGISTRATION=true
# Set to false after creating your account if this is a personal app.

# Supabase: copy Connect > Session pooler; percent-encode special characters
# in the password. Use TLS certificate verification (see README).
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=C:/path/to/supabase-ca.crt
# For Render set HOST=0.0.0.0 in its environment, and use the supplied PORT.
